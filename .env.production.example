# Production JARVIS Core template.
# Copy to .env.production on the Ubuntu host and replace every placeholder.
# Never commit the populated .env.production file.

APP_ENV=production
LOG_LEVEL=INFO

JARVIS_AUTH_ENABLED=true
JARVIS_CLIENT_TOKEN=<set-a-long-random-client-token>

LLM_PROVIDER=openai
LLM_MODEL=qwen/qwen3.6-27b
LLM_API_KEY=<set-provider-api-key>
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_REASONING_EFFORT=none
LLM_MAX_COMPLETION_TOKENS=768
LLM_TEMPERATURE=0.3
LLM_ROUTER_MODEL=
LLM_ROUTER_REASONING_EFFORT=
LLM_ROUTER_REASONING_FORMAT=
LLM_ROUTER_TEMPERATURE=0.0
LLM_ROUTER_MAX_COMPLETION_TOKENS=64

STT_ENABLED=true
STT_PROVIDER=faster_whisper
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=ko
STT_BEAM_SIZE=1
STT_VAD_FILTER=true
STT_CPU_THREADS=6
STT_PRELOAD=true
STT_TIMEOUT_SECONDS=60
STT_MAX_FILE_MB=20
STT_MAX_CONCURRENT_REQUESTS=1
STT_MODEL_CACHE_DIR=

TTS_ENABLED=true
TTS_PROVIDER=supertonic
TTS_MODEL=supertonic3
JARVIS_TTS_MODEL_DIR=data/models/tts/supertonic-3
TTS_LANGUAGE=ko
TTS_DEVICE=cpu
TTS_NUM_THREADS=2
TTS_PRELOAD=true
TTS_TIMEOUT_SECONDS=60
TTS_MAX_CONCURRENT_REQUESTS=1
TTS_VOICE_PROFILE=supertonic_default
GPT_SOVITS_BASE_URL=http://127.0.0.1:9880
GPT_SOVITS_TIMEOUT_SECONDS=30
GPT_SOVITS_FALLBACK_TO_SUPERTONIC=false

JARVIS_DATA_DIR=data
JARVIS_DB_PATH=data/jarvis.db
JARVIS_TEMP_DIR=
VOICE_LATENCY_METRICS=true
